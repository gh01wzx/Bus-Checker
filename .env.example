# Copy to .env and fill in. Never commit .env.

# Auckland Transport API subscription key (https://dev-portal.at.govt.nz/)
AT_SUB_KEY=

# Warehouse: duckdb or postgres. Docker defaults to postgres; native Python to duckdb.
# BUS_BACKEND=duckdb

# --- Native (non-Docker) paths; defaults shown -------------------------------------------
# BUS_DUCKDB_PATH=data/warehouse/bus.duckdb
# BUS_SNAPSHOT_PATH=data/published/bus_dashboard.duckdb
# BUS_ARCHIVE_DIR=data/archive            # "off" disables the raw payload archive
# BUS_POSTGRES_URL=postgresql://bus_writer:password@localhost:5432/bus

# --- Retention ----------------------------------------------------------------------------
# BUS_ARCHIVE_RETENTION_DAYS=14           # raw JSON archive files (0 keeps forever)
# BUS_RAW_RETENTION_DAYS=0                # raw warehouse rows (0 keeps forever)
# BUS_OPS_RETENTION_DAYS=90               # fetch/dbt/publication audit rows
# BUS_GTFS_REFRESH_HOURS=24

# --- Online publication (Supabase or any PostgreSQL) --------------------------------------
# Use the publisher role from deploy/supabase/setup.sql and the session pooler (port 5432).
# BUS_PUBLISH_URL=postgresql://bus_publisher.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# BUS_PUBLISH_SCHEDULE=*/15 * * * *
# BUS_PUBLISH_DAILY_DAYS=400              # daily marts kept online
# BUS_PUBLISH_HOURLY_DAYS=62              # hourly marts kept online
# BUS_PUBLISH_DETAIL_DAYS=31              # stop-level and cancelled-trip detail kept online

# --- Local Docker credentials (loopback-only demo defaults are used when unset) ----------
# Set these before the first `docker compose up`; changing them later does not rotate roles.
# LOCAL_PG_ADMIN_PASSWORD=
# LOCAL_BUS_WRITER_PASSWORD=
# LOCAL_BUS_READER_PASSWORD=
# LOCAL_AIRFLOW_DB_PASSWORD=              # URL-safe characters only
# AIRFLOW_JWT_SECRET=
# AIRFLOW_API_SECRET_KEY=
# AIRFLOW_FERNET_KEY=
