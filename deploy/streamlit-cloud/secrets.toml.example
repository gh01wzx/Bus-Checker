# Streamlit Community Cloud -> your app -> Settings -> Secrets. Root-level secrets are exposed
# to the app as environment variables, which is how Bus Checker reads its configuration.
BUS_BACKEND = "postgres"
BUS_POSTGRES_URL = "postgresql://bus_dashboard.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
